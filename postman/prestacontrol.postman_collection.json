{
  "info": {
    "_postman_id": "8f1c2a90-bellodas-prestacontrol",
    "name": "PrestaControl API - bellodas",
    "description": "7 endpoints del Ejercicio 1 + endpoint de resumen y casos 401. El token se guarda automaticamente en la variable de coleccion 'token'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Registrar prestamista (publico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y token JWT', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.tipo).to.eql('Bearer');",
                  "  pm.collectionVariables.set('token', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prestamista Postman\",\n  \"email\": \"postman@test.com\",\n  \"password\": \"clave123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "2. Iniciar sesion (publico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y token JWT', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('token', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman@test.com\",\n  \"password\": \"clave123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Seguridad",
      "item": [
        {
          "name": "Sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin token', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/prestamos", "host": ["{{baseUrl}}"], "path": ["prestamos"] }
          }
        },
        {
          "name": "Token alterado -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 con token alterado', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer tokenAlterado123" }
            ],
            "url": { "raw": "{{baseUrl}}/prestamos", "host": ["{{baseUrl}}"], "path": ["prestamos"] }
          }
        }
      ]
    },
    {
      "name": "Prestamos",
      "item": [
        {
          "name": "3. Registrar prestamo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 y total calculado', function () {",
                  "  pm.response.to.have.status(201);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.total).to.eql(1100.00);",
                  "  pm.expect(data.monto).to.eql(1000.00);",
                  "  pm.expect(data.interes).to.eql(10.00);",
                  "  pm.collectionVariables.set('prestamoId', data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Juan Perez\",\n  \"dni\": \"12345678\",\n  \"monto\": 1000.00,\n  \"interes\": 10.00,\n  \"fechaVencimiento\": \"2026-12-31\",\n  \"pagado\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/prestamos", "host": ["{{baseUrl}}"], "path": ["prestamos"] }
          }
        },
        {
          "name": "4. Listar prestamos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y lista con total', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(data[0]).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/prestamos", "host": ["{{baseUrl}}"], "path": ["prestamos"] }
          }
        },
        {
          "name": "5. Obtener prestamo por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y prestamo propio', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('prestamoId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/prestamos/{{prestamoId}}", "host": ["{{baseUrl}}"], "path": ["prestamos", "{{prestamoId}}"] }
          }
        },
        {
          "name": "6. Resumen de cartera (extra)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y resumen', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.capitalPrestado).to.eql(1000.00);",
                  "  pm.expect(data.totalPorCobrar).to.eql(1100.00);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/prestamos/resumen", "host": ["{{baseUrl}}"], "path": ["prestamos", "resumen"] }
          }
        },
        {
          "name": "7. Actualizar prestamo (marcar pagado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y pagado=true', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().pagado).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Juan Perez\",\n  \"dni\": \"12345678\",\n  \"monto\": 1000.00,\n  \"interes\": 10.00,\n  \"fechaVencimiento\": \"2026-12-31\",\n  \"pagado\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/prestamos/{{prestamoId}}", "host": ["{{baseUrl}}"], "path": ["prestamos", "{{prestamoId}}"] }
          }
        },
        {
          "name": "8. Eliminar prestamo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 sin contenido', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/prestamos/{{prestamoId}}", "host": ["{{baseUrl}}"], "path": ["prestamos", "{{prestamoId}}"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "prestamoId", "value": "1" }
  ]
}
